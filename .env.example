# All env vars below are optional. With nothing set, the CLI falls back to
# free public RPCs — no signup, but rate-limited and slower.

# Premium RPC: any Alchemy app key (one app, all 5 chains).
# Sign up at alchemy.com → create an app → enable Ethereum, Optimism,
# Polygon, Base, and Arbitrum mainnets → copy the key here.
ALCHEMY_API_KEY=

# Per-chain RPC overrides. Comma-separated `chainId=url`. Takes precedence
# over Alchemy and the public fallback. Use any provider you want
# (QuickNode, Infura, dRPC, your own node, …). You can override just one
# chain and leave the rest on Alchemy / public.
# Example: RPC_URLS=1=https://your-eth-rpc,8453=https://your-base-rpc
RPC_URLS=
